# --- CONFIGURATIONS DES CHEMINS POUR LE VISUALISEUR 3D ---

# Chemin vers le fichier de prédictions .pkl (généré ou à générer)
PKL_FILE_PATH=output/predictions.pkl

# Chemin de configuration Pose2Sim (laissée vide ou commentée pour utiliser la configuration dynamique par défaut de Pose2Sim)
# CONFIG_FILE_PATH=

# Fichier de calibration des caméras
CALIB_FILE_PATH=configs/Calib.toml

# Chemin de sortie du fichier .trc triangulé 3D (le dossier pose-3d est attendu ici)
TRC_OUTPUT_PATH=output/pose-3d/triangulated.trc

# Chemins des poids des modèles (YOLO et ViTPose)
YOLO_WEIGHTS_PATH=weights/YOLO26s_best.pt
VITPOSE_WEIGHTS_PATH=weights/best_mvssl_AP713_iter290.pth

# Index du saut à isoler (optionnel)
JUMP_INDEX=
